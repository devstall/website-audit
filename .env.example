# Copy to .env (or set these in your hosting panel's "Environment variables").

# Dashboard login. Required on any public server; the app refuses to start publicly without it.
WII_USER=admin
WII_PASSWORD=change-me-to-a-long-password

# Where reports, screenshots and settings are saved. Use a folder OUTSIDE the app folder on hosts
# that redeploy from GitHub, so redeploys never delete your reports.
# WII_DATA_DIR=/home/YOUR_USER/wii-data

# Optional: only needed for the WordPress plugin to call the API.
# WII_API_KEY=another-long-secret

# Usually set by the host automatically.
# PORT=4173
# HOST=0.0.0.0

# Parallel audits. Keep 1 on shared hosting.
# WII_CONCURRENCY=1
